10 REM IRONKEEP 48 - PURE SINCLAIR BASIC
20 BORDER 0: PAPER 0: INK 7: BRIGHT 0: CLEAR
30 GO SUB 8000
40 GO SUB 8500
50 LET x=2: LET y=2: LET d=1: LET hp=100: LET am=8: LET ky=0: LET kills=0: LET turns=0
60 LET h$="FIND THE BRASS KEY. REACH EXIT."
70 GO TO 100
100 LET fx=f(d+1,1): LET fy=f(d+1,2): GO SUB 2000
110 IF INKEY$<>"" THEN GO TO 110
120 LET k$=INKEY$: IF k$="" THEN GO TO 120
130 LET kc=CODE k$: IF kc>=65 AND kc<=90 THEN LET k$=CHR$ (kc+32)
140 IF k$="m" THEN GO SUB 6000: GO TO 100
150 IF k$="h" THEN GO SUB 6500: GO TO 100
160 LET act=0: LET redraw=1: LET h$=""
170 IF k$="a" THEN LET d=d+3: LET d=d-4*INT (d/4): LET act=1
180 IF k$="d" THEN LET d=d+1: LET d=d-4*INT (d/4): LET act=1
190 IF k$="w" OR k$="s" THEN GO SUB 1000
200 IF k$=" " THEN GO SUB 1300
210 IF k$="e" THEN GO SUB 1600
220 IF act=0 AND h$="" THEN GO TO 120
230 IF act=1 THEN LET turns=turns+1: GO SUB 4000
240 IF hp<=0 THEN GO TO 7500
245 IF redraw=0 THEN GO SUB 2250: GO TO 110
250 GO TO 100
1000 REM MOVE ONE SQUARE
1010 LET step=1: IF k$="s" THEN LET step=-1
1020 LET nx=x+fx*step: LET ny=y+fy*step: LET c$=m$(ny,nx)
1030 IF c$="#" THEN LET h$="SOLID WALL.": RETURN
1040 IF c$="D" THEN LET h$="DOOR: FACE IT AND PRESS E.": RETURN
1050 IF p$(ny,nx)<>" " THEN LET h$="GUARD BLOCKING THE WAY.": RETURN
1080 IF c$="X" AND ky=0 THEN LET h$="EXIT LOCKED. FIND THE BRASS KEY.": RETURN
1090 LET x=nx: LET y=ny: LET act=1
1100 IF c$="X" THEN GO TO 7000
1110 IF c$="A" THEN LET am=am+8: LET h$="AMMO BOX: +8 ROUNDS.": BEEP .03,12
1120 IF c$="+" THEN LET hp=hp+30: LET h$="FIELD DRESSING: +30 HEALTH.": BEEP .03,18
1130 IF hp>100 THEN LET hp=100
1140 IF c$="K" THEN LET ky=1: LET h$="BRASS KEY TAKEN. FIND THE EXIT.": BEEP .06,24
1150 LET m$(y,x)=".": RETURN
1300 REM SHOOT THE NEAREST GUARD AHEAD
1310 IF am=0 AND (target=0 OR range>1) THEN LET h$="EMPTY. KNIFE WORKS ONE TILE AWAY.": BEEP .02,-12: RETURN
1320 LET act=1: LET redraw=0
1330 IF am>0 THEN LET am=am-1: BEEP .025,-8
1340 IF target=0 THEN LET h$="SHOT HIT THE WALL.": RETURN
1350 LET g(target,3)=g(target,3)-1
1360 IF g(target,3)>0 THEN LET h$="GUARD HIT. FIRE AGAIN.": RETURN
1370 LET redraw=1: LET p$(g(target,2),g(target,1))=" ": LET kills=kills+1: LET am=am+1: LET h$="GUARD DOWN. +1 ROUND.": BEEP .025,-16: RETURN
1600 REM OPEN A DOOR DIRECTLY AHEAD
1610 LET nx=x+fx: LET ny=y+fy
1620 IF m$(ny,nx)<>"D" THEN LET h$="NO DOOR DIRECTLY AHEAD.": RETURN
1630 LET m$(ny,nx)=".": LET act=1: LET h$="DOOR OPEN.": BEEP .06,-10: RETURN
2000 REM PRECOMPUTED PERSPECTIVE WALL PANELS
2010 PAPER 0: INK 7: BRIGHT 0: OVER 0: CLS
2020 PRINT AT 0,0; INK 6;"IRONKEEP 48";AT 0,17; INK 7;"FACING ";n$(d+1);AT 0,28;kills;"/8"
2030 PRINT AT 1,0; INK 1;"--------------------------------"
2040 LET target=0: LET range=5: LET o$="": LET ir=5
2050 FOR z=1 TO 4
2060 LET cx=x+(z-1)*fx: LET cy=y+(z-1)*fy
2070 LET c$=m$(cy-fx,cx+fy): LET j=3: IF c$="#" OR c$="D" THEN LET j=1
2080 PRINT v$(z,j, TO l(z,j));
2090 LET c$=m$(cy+fx,cx-fy): LET j=4: IF c$="#" OR c$="D" THEN LET j=2
2100 PRINT v$(z,j, TO l(z,j));
2110 LET nx=cx+fx: LET ny=cy+fy: LET c$=m$(ny,nx)
2120 IF c$="#" THEN PRINT v$(z,5, TO l(z,5));: GO TO 2200
2130 IF c$="D" THEN PRINT v$(z,6, TO l(z,6));: IF z=1 THEN PRINT AT 9,12; PAPER 6; INK 0;"E: OPEN"
2140 IF c$="D" THEN GO TO 2200
2150 IF c$<>"." AND o$="" THEN LET o$=c$: LET ir=z
2160 LET i=CODE p$(ny,nx)-48
2170 IF target=0 AND i>0 THEN LET target=i: LET range=z
2190 NEXT z
2200 PAPER 0: INK 7
2210 IF target>0 THEN PRINT s$(range, TO e(range));
2220 IF ir<range THEN GO SUB 2500
2230 PRINT u$;
2240 PRINT AT 9,15; OVER 1; INK 7;"+"; OVER 0
2250 PRINT AT 18,0; PAPER 1; INK 7;" E DOOR     M MAP     H HELP     "
2260 PRINT AT 19,0; PAPER 0; INK 7;"HEALTH ";hp;"  AMMO ";am;"  KEY ";ky;"   "
2270 IF LEN h$>32 THEN LET h$=h$( TO 32)
2280 PRINT AT 20,0; PAPER 0; INK 6;"                                ";AT 20,0;h$;
2290 PRINT AT 21,0; INK 7;"W/S MOVE  A/D TURN  SPACE FIRE"
2300 RETURN
2500 REM A PICKUP OR EXIT MARKER IN THE CORRIDOR
2510 LET r=18-b(ir+1): LET pc=6: LET t$=o$
2520 IF o$="+" THEN LET pc=2
2530 IF o$="A" THEN LET pc=7
2540 IF o$="X" THEN LET pc=4
2550 PRINT AT r,15; PAPER 0; INK pc;t$: RETURN
4000 REM GUARDS GET ONE WARNING TURN BEFORE FIRING
4010 LET damage=0
4020 FOR i=1 TO 8
4030 IF g(i,3)=0 THEN GO TO 4190
4040 LET gx=g(i,1): LET gy=g(i,2): LET dist=ABS (gx-x)+ABS (gy-y)
4050 IF (gx<>x AND gy<>y) OR dist>4 THEN GO TO 4180
4060 LET dx=SGN (gx-x): LET dy=SGN (gy-y): LET seen=1
4070 IF dist=1 THEN GO TO 4110
4080 FOR q=1 TO dist-1
4090 LET c$=m$(y+q*dy,x+q*dx): IF c$="#" OR c$="D" THEN LET seen=0
4100 NEXT q
4110 IF seen=0 THEN GO TO 4180
4120 LET g(i,4)=g(i,4)+1
4130 IF g(i,4)=1 AND h$="" THEN LET h$="A GUARD IS RAISING HIS RIFLE!"
4140 IF g(i,4)>1 THEN LET hp=hp-8: LET damage=damage+8
4150 GO TO 4190
4180 LET g(i,4)=0
4190 NEXT i
4200 IF damage>0 THEN BORDER 2: BEEP .04,-12: BORDER 0: LET h$=h$+" -"+STR$ damage+" HP"
4210 RETURN
6000 REM FULL BLUEPRINT - NO TURN COST
6010 PAPER 0: INK 7: CLS
6020 PRINT AT 0,5; INK 6;"IRONKEEP BLUEPRINT"
6030 FOR r=1 TO 15
6040 PRINT AT r+1,8; INK 5;m$(r);
6050 NEXT r
6120 FOR i=1 TO 8
6130 IF g(i,3)>0 THEN PRINT AT g(i,2)+1,g(i,1)+7; INK 2;"G"
6140 NEXT i
6150 PRINT AT y+1,x+7; INK 7; FLASH 1;f$(d+1); FLASH 0
6160 PRINT AT 18,0;"D DOOR  K KEY  X EXIT  G GUARD"
6170 PRINT AT 19,0;"A AMMO  + HEALTH  ARROW = YOU"
6180 PRINT AT 21,0;"PRESS ANY KEY TO RETURN"
6190 GO SUB 6800: RETURN
6500 PAPER 0: INK 7: CLS
6510 PRINT AT 1,8; INK 6;"FIELD MANUAL"
6520 PRINT AT 4,1;"W / S  STEP FORWARD / BACK"
6530 PRINT AT 6,1;"A / D  TURN LEFT / RIGHT"
6540 PRINT AT 8,1;"SPACE  FIRE STRAIGHT AHEAD"
6550 PRINT AT 10,1;"E      OPEN ADJACENT DOOR"
6560 PRINT AT 12,1;"M      BLUEPRINT (FREE)"
6570 PRINT AT 14,1;"GUARDS TAKE TWO HITS."
6580 PRINT AT 15,1;"NO AMMO? SPACE KNIFES AT 1 TILE."
6590 PRINT AT 17,1;"GUARDS ACT ONLY WHEN YOU ACT."
6600 PRINT AT 18,1;"TAP KEYS; RELEASE BETWEEN MOVES."
6610 PRINT AT 21,1;"PRESS ANY KEY"
6620 GO SUB 6800: RETURN
6800 IF INKEY$<>"" THEN GO TO 6800
6810 IF INKEY$="" THEN GO TO 6810
6820 RETURN
7000 PAPER 0: INK 7: CLS: BORDER 4
7010 PRINT AT 5,8; INK 4;"YOU ARE OUT."
7020 PRINT AT 8,3;"THE BRASS KEY TURNS. YOU PUSH"
7030 PRINT AT 9,3;"THROUGH THE SERVICE GATE."
7040 PRINT AT 12,5;"GUARDS DOWN: ";kills;" / 8"
7050 PRINT AT 14,5;"HEALTH LEFT: ";hp
7060 PRINT AT 16,5;"ACTIONS: ";turns+1
7070 BEEP .12,12: BEEP .12,16: BEEP .2,19
7080 GO TO 7600
7500 PAPER 0: INK 7: CLS: BORDER 2
7510 PRINT AT 6,7; INK 2;"KILLED IN ACTION"
7520 PRINT AT 10,4;"GUARDS DOWN: ";kills;" / 8"
7530 PRINT AT 12,4;"BREAK SIGHTLINES. USE COVER."
7540 PRINT AT 14,4;"FIND THE FIELD DRESSINGS."
7550 BEEP .3,-20
7600 PRINT AT 19,5;"PRESS R TO TRY AGAIN"
7610 IF INKEY$<>"r" AND INKEY$<>"R" THEN GO TO 7610
7620 RUN
8000 REM TITLE AND BRIEFING
8010 CLS
8020 PRINT AT 2,5; INK 6;"I R O N K E E P   4 8"
8030 PRINT AT 4,5; INK 5;"A FIRST-PERSON ESCAPE"
8040 PRINT AT 7,2; INK 7;"YOU HAVE A STOLEN PISTOL AND"
8050 PRINT AT 8,2;"EIGHT ROUNDS. FIND THE BRASS"
8060 PRINT AT 9,2;"KEY AND GET OUT OF THE KEEP."
8070 PRINT AT 12,2;"W/S MOVE   A/D TURN   E DOOR"
8080 PRINT AT 14,2;"SPACE FIRE   M MAP   H HELP"
8090 PRINT AT 17,2; INK 6;"100% SINCLAIR BASIC / 48K"
8100 PRINT AT 19,2; INK 7;"STEP-BASED. TAKE YOUR TIME."
8110 PRINT AT 21,7;"PRESS ANY KEY"
8120 GO SUB 6800
8130 CLS: PRINT AT 10,1;"PREPARING VIEW... ABOUT 40 SEC": RETURN
8500 REM MAP AND ENEMIES
8510 DIM m$(15,15): RESTORE 9000
8520 FOR i=1 TO 15: READ m$(i): NEXT i
8530 DIM g(8,4): DIM p$(15,15)
8540 FOR i=1 TO 8: READ g(i,1),g(i,2): LET g(i,3)=2: LET p$(g(i,2),g(i,1))=CHR$ (48+i): NEXT i
8550 DIM f(4,2): FOR i=1 TO 4: READ f(i,1),f(i,2): NEXT i
8560 LET n$="NESW": LET f$="^"+">"+"v"+"<"
8570 DIM a(5): DIM b(5): FOR i=1 TO 5: READ a(i),b(i): NEXT i
8580 RESTORE 9300: FOR i=0 TO 95: READ q: POKE USR "a"+i,q: NEXT i
8590 LET b$="": FOR i=1 TO 32: LET b$=b$+CHR$ 144: NEXT i
8600 LET d$="": FOR i=1 TO 32: LET d$=d$+CHR$ 145: NEXT i
8610 DIM v$(4,6,300): DIM l(4,6)
8620 FOR z=1 TO 4: FOR j=1 TO 6
8630 LET w$=CHR$ 16+CHR$ 5+CHR$ 17+CHR$ 1
8640 IF j=3 OR j=4 OR z=4 THEN LET w$=CHR$ 16+CHR$ 1+CHR$ 17+CHR$ 0
8650 IF j=5 THEN LET w$=CHR$ 16+CHR$ 7+CHR$ 17+CHR$ 1
8660 IF j=6 THEN LET w$=CHR$ 16+CHR$ 0+CHR$ 17+CHR$ 6
8670 LET top=b(z): LET bot=19-top: IF j>=3 THEN LET top=b(z+1): LET bot=19-top
8680 FOR r=top TO bot
8690 LET wid=a(z+1)-a(z): LET c=a(z)
8700 IF j<=2 THEN LET t=r: IF t>9 THEN LET t=19-t
8710 IF j<=2 AND t<b(z+1) THEN LET wid=1+INT ((t-b(z))*(a(z+1)-a(z))/(b(z+1)-b(z)))
8720 IF j=2 OR j=4 THEN LET c=32-a(z)-wid
8730 IF j>=5 THEN LET c=a(z+1): LET wid=32-2*c
8740 LET t$=b$( TO wid): IF j=6 THEN LET t$=d$( TO wid)
8750 LET w$=w$+CHR$ 22+CHR$ r+CHR$ c+t$
8760 NEXT r
8770 LET l(z,j)=LEN w$: LET v$(z,j)=w$
8780 NEXT j: NEXT z
8790 DIM s$(4,180): DIM e(4): RESTORE 9400
8800 FOR z=1 TO 4: READ nr: LET w$=""
8810 FOR i=1 TO nr: READ r,c,pc,t$
8820 LET w$=w$+CHR$ 22+CHR$ r+CHR$ c+CHR$ 16+CHR$ pc+CHR$ 17+CHR$ 0
8830 FOR j=1 TO LEN t$: LET w$=w$+CHR$ (CODE t$(j)+64): NEXT j
8840 NEXT i: LET e(z)=LEN w$: LET s$(z)=w$: NEXT z
8850 READ nr: LET u$=""
8860 FOR i=1 TO nr: READ r,c,pc,t$: LET u$=u$+CHR$ 22+CHR$ r+CHR$ c+CHR$ 16+CHR$ pc+CHR$ 17+CHR$ 0
8870 FOR j=1 TO LEN t$: LET u$=u$+CHR$ (CODE t$(j)+64): NEXT j: NEXT i
8880 RETURN
